# Environment variables for the application
DB_HOST=db
DB_NAME=mydb
DB_USER=dev
DB_PASS=VeryStrongPassword
# Environment variables for MySQL
MYSQL_DATABASE=mydb
MYSQL_USER=dev
MYSQL_PASSWORD=VeryStrongPassword
MYSQL_ROOT_PASSWORD=VeryStrongRootPassword
# Environment variables for phpMyAdmin
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=VeryStrongRootPassword
REDIS_HOST=redis
REDIS_PORT=6379