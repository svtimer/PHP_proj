# For db service
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-symbolic-links
skip-host-cache

# logging
general_log = 1
general_log_file = /var/lib/mysql/general.log
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

# optimization
innodb_buffer_pool_size = 256M
max_connections = 200